# 复制为 .env 再填写(.env 已被 .gitignore 忽略,不会进仓库)
#   cp .env.example .env  &&  vi .env
ADMIN_USER=admin
ADMIN_PASS=换成你自己的强密码

# 对外集成 API 独立令牌；未设置时接口保持关闭。请只在测试环境配置强随机值。
INTEGRATION_API_TOKEN=换成至少32位的随机令牌

# MySQL(众包上报 / 共识数据;配置仍走文件)
MYSQL_ROOT_PASSWORD=换成强密码-root
DB_NAME=webaccel
DB_USER=webaccel
DB_PASS=换成强密码-业务库
