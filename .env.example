# 复制为 .env 再填写(.env 已被 .gitignore 忽略,不会进仓库)
#   cp .env.example .env  &&  vi .env
ADMIN_USER=admin
ADMIN_PASS=换成你自己的强密码

# 对外集成 API 独立令牌；某环境未设置时，该环境接口保持关闭。三个环境必须使用不同强随机值。
# 兼容旧版无环境前缀的测试接口；建议与 TEST 保持一致。
INTEGRATION_API_TOKEN=换成至少32位的测试环境随机令牌
INTEGRATION_API_TOKEN_TEST=换成至少32位的测试环境随机令牌
INTEGRATION_API_TOKEN_PRE=换成至少32位的预发环境随机令牌
INTEGRATION_API_TOKEN_PROD=换成至少32位的生产环境随机令牌

# MySQL(众包上报 / 共识数据;配置仍走文件)
MYSQL_ROOT_PASSWORD=换成强密码-root
DB_NAME=webaccel
DB_USER=webaccel
DB_PASS=换成强密码-业务库
