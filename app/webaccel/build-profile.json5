{
  "apiType": "stageMode",
  "buildOption": {
    "arkOptions": {
      // 后台地址默认值(debug/开发):跑 admin 的电脑局域网 IP。代码读 BuildProfile.CONFIG_SERVER。
      "buildProfileFields": {
        "CONFIG_SERVER": "http://192.168.20.133:8787"
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        // 后台地址(release/上线):改成你的生产域名,只改这一处、且只在 release 生效。
        "buildProfileFields": {
          "CONFIG_SERVER": "https://admin.example.com"
        },
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          },
          "consumerFiles": [
            "./consumer-rules.txt"
          ]
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    }
  ]
}
